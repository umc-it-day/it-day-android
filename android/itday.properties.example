# Copy this file to android/itday.properties and fill local values.
# Do not commit android/itday.properties.

ITDAY_DEBUG_API_BASE_URL=http://10.0.2.2:8080/
ITDAY_DEBUG_USE_MOCK_DATA=true
ITDAY_DEBUG_USE_MOCK_KAKAO_LOGIN=true
ITDAY_SHOW_ONBOARDING_DEBUG_ENTRY=false
ITDAY_RELEASE_API_BASE_URL=
ITDAY_RELEASE_USE_MOCK_DATA=false
ITDAY_RELEASE_USE_MOCK_KAKAO_LOGIN=false

# Kakao Developers > App > Platform key > Native app key
ITDAY_KAKAO_NATIVE_APP_KEY=

# Kakao Developers > App > App Keys > REST API key
ITDAY_KAKAO_REST_API_KEY=

